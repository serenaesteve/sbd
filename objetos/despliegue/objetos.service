[Unit]
Description=El Baúl: base de datos de objetos sobre SBD
After=network-online.target sbd.service
Wants=network-online.target sbd.service

[Service]
Type=simple
User=objetos
WorkingDirectory=/srv/objetos
# La clave de API de SBD: solo la lee systemd, al arrancar
EnvironmentFile=/srv/objetos/entorno
ExecStart=/srv/objetos/venv/bin/python3 -m biblioteca.web --sbd http://127.0.0.1:8090 --base objetos --puerto 8099
Restart=on-failure
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=15
# Endurecimiento: no escribe en ningún sitio, sus objetos están en el servidor de SBD.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
